# IELTS SPEAKING PRACTICE - Environment Variables
# Copy to .env and fill in. NEVER commit .env.

# Required: Google AI API key (Gemini Live voice + pronunciation audio review)
GEMINI_API_KEY=

# Required for band scoring: DeepSeek API key (text evaluation: fluency/lexical/grammar)
DEEPSEEK_API_KEY=

# Optional: override DeepSeek model (default deepseek-chat)
DEEPSEEK_MODEL=

# Optional: override pronunciation review model (default gemini-2.5-flash)
PRONUNCIATION_MODEL=gemini-2.5-flash

# Supabase Postgres session pooler (progress + session history survive redeploys).
# Falls back to local JSONL files when unset.
SUPABASE_DB_URL=

# Max concurrent Gemini Live sessions (Render free tier: keep low)
MAX_SESSIONS=5

# Comma-separated allowed browser origins for CORS (Netlify site URL)
# e.g. https://your-site.netlify.app
CORS_ORIGINS=

# Backend port
PORT=8000

# Frontend build: points the UI at this backend
# VITE_BACKEND_URL=https://your-render-service.onrender.com
