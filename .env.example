# IELTS SPEAKING PRACTICE - Environment Variables
# Copy to .env and fill in. NEVER commit .env.

# Required: Google AI API key (Gemini Live voice + band scoring + pronunciation)
# GEMINI_API_KEY must have access to the Gemini Live API (billing enabled).
GEMINI_API_KEY=

# Text scoring provider: gemini (default, recommended) or deepseek (optional).
# Gemini reuses GEMINI_API_KEY, so no extra key is needed for real scoring.
TEXT_EVAL_PROVIDER=gemini

# Optional: override Gemini text-scoring model (default gemini-2.5-flash)
TEXT_EVAL_MODEL=gemini-2.5-flash

# Optional: second Gemini model tried when the primary scorer errors (default gemini-2.5-flash-lite)
TEXT_EVAL_FALLBACK_MODEL=gemini-2.5-flash-lite

# Optional: DeepSeek alternative text evaluator (only used when provider=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Optional: override pronunciation review model (default gemini-2.5-flash)
PRONUNCIATION_MODEL=gemini-2.5-flash

# Supabase Postgres session pooler (progress + session history survive redeploys).
# Falls back to local JSONL files when unset.
SUPABASE_DB_URL=

# Max concurrent Gemini Live sessions (Render free tier: keep low)
MAX_SESSIONS=5

# CORS: this public cookie-less app allows every origin (default "*").
# CORS_ORIGINS is optional and only informational; leaving it empty is fine.
CORS_ORIGINS=*

# Backend port
PORT=8000

# Frontend build: points the UI at this backend
# VITE_BACKEND_URL=https://your-render-service.onrender.com
